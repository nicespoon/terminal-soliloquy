[Unit]
Description=Terminal Soliloquy Service
After=graphical-session.target ollama.service
Wants=ollama.service

[Service]
Type=simple
WorkingDirectory=%h/terminal-soliloquy

Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/%U

# ExecStart without invalid --override flags
ExecStart=/usr/bin/foot -D %h/terminal-soliloquy --fullscreen %h/terminal-soliloquy/.venv/bin/terminal-soliloquy

Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target