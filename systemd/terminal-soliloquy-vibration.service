[Unit]
Description=SW-420 Vibration Listener for Terminal Soliloquy
After=graphical-session.target ollama.service
Wants=ollama.service

[Service]
Type=simple
WorkingDirectory=%h/terminal-soliloquy

Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/%U

ExecStart=%h/terminal-soliloquy/.venv/bin/python3 %h/terminal-soliloquy/vibration_trigger.py

Restart=always
RestartSec=3

[Install]
WantedBy=default.target